@model FrontendMVC.Models.ViewModels.EleveViewModel
@{
    ViewData["Title"] = "Créer un élève";
}

<div class="card shadow-lg border-0 w-100 mx-auto mt-4" style="max-width: 800px;">
    <div class="card-header bg-dark text-white text-center py-3 rounded-top">
        <h3 class="mb-0"><i class="bi bi-building-fill"></i> Nouvel élève</h3>
    </div>

    <div class="card-body px-4 py-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row g-3">
                <div class="col-md-12" asp-validation-summary="None"></div>
                <div class="col-md-6">
                    <label asp-for="NomEleve" class="form-label fw-semibold"></label>
                    <input asp-for="NomEleve" class="form-control" placeholder="Ex: John" />
                    <span asp-validation-for="NomEleve" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PostNomEleve" class="form-label fw-semibold"></label>
                    <input asp-for="PostNomEleve" class="form-control" placeholder="Ex: Doe" />
                    <span asp-validation-for="PostNomEleve" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SexeEleve" class="form-label fw-semibold"></label>
                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               asp-for="SexeEleve"
                               value="Masculin"
                               id="sexeM" />
                        <label class="form-check-label" for="sexeM">
                            Masculin
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               asp-for="SexeEleve"
                               value="Féminin"
                               id="sexeF" />
                        <label class="form-check-label" for="sexeF">
                            Féminin
                        </label>
                    </div>
                    <span asp-validation-for="SexeEleve" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LieuNaisEleve" class="form-label fw-semibold"></label>
                    <input asp-for="LieuNaisEleve" class="form-control" placeholder="Ex: Kinshasa" />
                    <span asp-validation-for="LieuNaisEleve" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DateNaisEleve" class="form-label fw-semibold"></label>
                    <input asp-for="DateNaisEleve" class="form-control" type="date" placeholder="Ex: jj/mm/aaaa" />
                    <span asp-validation-for="DateNaisEleve" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="PhotoFile" class="form-label fw-semibold">Photo</label>
                    <input type="file" asp-for="PhotoFile" class="form-control" />
                    <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                </div>

               
                <div class="col-12 text-center pt-3">
                    <button type="submit" class="btn btn-success px-4 me-2">
                        <i class="bi bi-check-circle"></i> Enregistrer
                    </button>
                    <a asp-controller="Eleves" asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
